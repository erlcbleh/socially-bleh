  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([isShared, updatedAt(sort: Desc)])
  @@index([userId, panelId])
}

model StaffNote {
  id         String   @id @db.Char(24)
  authorId   String   @db.Char(24)
