model BusinessCollaborator {
  id             String   @id @db.Char(24)
  businessUserId String   @db.Char(24)
  userId         String   @db.Char(24)
  role           String   @default("collaborator")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  businessUser   User     @relation("BizCollabBusiness", fields: [businessUserId], references: [id], onDelete: Cascade)
  user           User     @relation("BizCollabUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessUserId, userId])
  @@index([userId])
}

model EmailConversation {
  id              String   @id @db.Char(24)
  subject         String
  status          String   @default("open")
  mailbox         String   @default("support")
  customerEmail   String
  claimedBy       String?  @db.Char(24)
  claimedAt       DateTime?
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  claimStaff      User?    @relation("EmailClaimedBy", fields: [claimedBy], references: [id], onDelete: SetNull)
  emails          Email[]
  internalNotes   InternalNote[]
  drafts          EmailDraft[]
  auditLogs       EmailAuditLog[]

  @@index([status])
  @@index([claimedBy])
  @@index([updatedAt(sort: Desc)])
  @@index([customerEmail])
  @@index([mailbox, status])
  @@index([mailbox, updatedAt(sort: Desc)])
}

model Email {
  id              String   @id @db.Char(24)
  messageId       String   @unique
  conversationId  String   @db.Char(24)
  direction       String
  from            String
  to              String[]
  cc              String[]
  bcc             String[]
  subject         String
  html            String?  @db.Text
  text            String?  @db.Text
  headers         Json     @default("{}")
  read            Boolean  @default(false)
  deliveryStatus  String   @default("delivered")
  receivedAt      DateTime?
  sentAt          DateTime?
  createdAt       DateTime @default(now())

  conversation    EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments     Attachment[]

  @@index([conversationId])
  @@index([direction])
  @@index([createdAt(sort: Desc)])
}

model Attachment {
  id              String   @id @db.Char(24)
  emailId         String   @db.Char(24)
  filename        String
  mimeType        String
  size            Int
  storagePath     String
  createdAt       DateTime @default(now())

  email           Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailDraft {
  id              String   @id @db.Char(24)
  conversationId  String   @db.Char(24)
  authorId        String   @db.Char(24)
  content         String   @db.Text
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  conversation    EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User    @relation("EmailDraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([conversationId, authorId])
  @@index([conversationId])
}

model InternalNote {
  id              String   @id @db.Char(24)
  conversationId  String   @db.Char(24)
  authorId        String   @db.Char(24)
  content         String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User    @relation("InternalNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
}

model EmailAuditLog {
  id              String   @id @db.Char(24)
  conversationId  String   @db.Char(24)
  staffId         String?  @db.Char(24)
  action          String
  details         Json     @default("{}")
  createdAt       DateTime @default(now())

  conversation    EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff           User?   @relation("EmailAuditLogStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([createdAt(sort: Desc)])
}
